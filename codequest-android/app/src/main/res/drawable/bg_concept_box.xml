<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F3F2FF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:left="0dp" android:right="0dp" android:top="0dp" android:bottom="0dp">
        <inset android:insetRight="0dp">
            <shape android:shape="rectangle">
                <solid android:color="@android:color/transparent" />
                <corners android:radius="12dp" />
                <stroke android:width="0dp" android:color="@android:color/transparent" />
            </shape>
        </inset>
    </item>
    
    <item android:width="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#6C63FF" />
            <corners android:topLeftRadius="12dp" android:bottomLeftRadius="12dp" />
        </shape>
    </item>
</layer-list>
