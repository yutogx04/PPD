<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/rounded_card"
    android:padding="14dp"
    android:layout_marginBottom="8dp">

    <ImageView
        android:id="@+id/tvModuleIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_box"
        app:tint="@color/primary"
        android:padding="8dp"
        android:background="@drawable/bg_badge_primary"
        android:backgroundTint="#F0EDFF"
        android:layout_marginEnd="12dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvModuleTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auto_module_1_les_bases"
            android:textSize="14sp"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/tvModuleMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auto_5_le_ons_2_d_fis"
            android:textSize="11sp"
            android:textColor="@color/text_muted" />

        <ProgressBar
            android:id="@+id/moduleProgress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progress="60"
            android:progressDrawable="@drawable/progress_gradient" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvModuleProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/auto_60"
        android:textSize="12sp"
        android:fontFamily="@font/poppins_bold"
        android:textColor="@color/primary"
        android:layout_marginStart="8dp" />
</LinearLayout>
