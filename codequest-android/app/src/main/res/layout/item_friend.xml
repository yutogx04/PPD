<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rounded_card"
    android:padding="14dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginBottom="8dp">

    <ImageView
        android:id="@+id/ivAvatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/circle_avatar"
        android:src="@drawable/ic_default_avatar"
        android:scaleType="centerInside"
        android:layout_marginEnd="12dp"
        android:contentDescription="Avatar" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPseudo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auto_hackmaster"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auto_niveau_5_actif_il_y_a_2h"
            android:textSize="12sp"
            android:textColor="@color/text_muted" />
    </LinearLayout>

    <Button
        android:id="@+id/btnAccept"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:background="@drawable/btn_primary"
        android:text="@string/accept_btn"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:textAllCaps="false"
        android:paddingHorizontal="12dp"
        android:layout_marginEnd="6dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnReject"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:background="@drawable/btn_outline"
        android:text="@string/reject_btn"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:textAllCaps="false"
        android:paddingHorizontal="12dp"
        android:visibility="gone" />

</LinearLayout>
