<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:background="@drawable/bg_gradient_primary">

            <ImageView
                android:id="@+id/btnSettings"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:src="@drawable/ic_settings"
                android:layout_gravity="end|top"
                android:padding="14dp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginTop="-48dp"
            android:paddingHorizontal="16dp">

            <FrameLayout
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:id="@+id/ivAvatar"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:background="@drawable/circle_avatar"
                    android:src="@drawable/ic_default_avatar"
                    android:scaleType="centerInside"
                    android:padding="3dp"
                    android:contentDescription="Avatar" />

                <TextView
                    android:id="@+id/tvLevelBadge"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:text="@string/auto_1"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:background="@drawable/bg_fab_gradient"
                    android:layout_gravity="end|bottom" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvUsername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auto_str_2"
                android:textSize="20sp"
                android:fontFamily="@font/poppins_bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvLevelText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auto_niveau_1_d_butant"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:id="@+id/earnedBadgesRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_s_rie_br_lante"
                    android:textSize="10sp"
                    android:textColor="@color/primary"
                    android:background="@drawable/bg_xp_purple"
                    android:drawableStart="@drawable/ic_fire"
                    android:drawablePadding="4dp"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_pro_python"
                    android:textSize="10sp"
                    android:textColor="@color/primary"
                    android:background="@drawable/bg_xp_purple"
                    android:drawableStart="@drawable/ic_lightning"
                    android:drawablePadding="4dp"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/rounded_card"
                android:padding="12dp"
                android:layout_marginEnd="6dp">
                <TextView
                    android:id="@+id/tvProfileXp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_0"
                    android:textSize="18sp"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/primary" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_xp"
                    android:textSize="10sp"
                    android:textColor="@color/text_muted" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/rounded_card"
                android:padding="12dp"
                android:layout_marginHorizontal="3dp">
                <TextView
                    android:id="@+id/tvProfileStreak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_0"
                    android:textSize="18sp"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/streak_fire" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_streak"
                    android:textSize="10sp"
                    android:textColor="@color/text_muted" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/rounded_card"
                android:padding="12dp"
                android:layout_marginHorizontal="3dp">
                <TextView
                    android:id="@+id/tvProfileLessons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_0"
                    android:textSize="18sp"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/success" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_le_ons"
                    android:textSize="10sp"
                    android:textColor="@color/text_muted" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/rounded_card"
                android:padding="12dp"
                android:layout_marginStart="6dp">
                <TextView
                    android:id="@+id/tvProfileChallenges"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_0"
                    android:textSize="18sp"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/xp_gold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_d_fis"
                    android:textSize="10sp"
                    android:textColor="@color/text_muted" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">
                <TextView
                    android:id="@+id/tvNextLevel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/auto_vers_niveau_2"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="@color/text_secondary" />
                <TextView
                    android:id="@+id/tvProfileXpProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_0_200"
                    android:textSize="12sp"
                    android:textColor="@color/text_muted" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/profileXpBar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/progress_gradient" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auto_badges"
            android:textSize="16sp"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="@color/text_primary"
            android:drawableStart="@drawable/ic_medal"
            android:drawablePadding="6dp"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvBadges"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:id="@+id/menuStats"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/rounded_card"
                android:paddingHorizontal="14dp"
                android:layout_marginBottom="8dp">
                <ImageView android:layout_width="20dp" android:layout_height="20dp"
                    android:src="@drawable/ic_chart" app:tint="@color/text_primary" android:layout_marginEnd="12dp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="@string/auto_statistiques" android:textSize="14sp"
                    android:textColor="@color/text_primary" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/auto_str_4" android:textSize="20sp" android:textColor="@color/text_muted" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/menuCerts"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/rounded_card"
                android:paddingHorizontal="14dp"
                android:layout_marginBottom="8dp">
                <ImageView android:layout_width="20dp" android:layout_height="20dp"
                    android:src="@drawable/ic_certificate" app:tint="@color/text_primary" android:layout_marginEnd="12dp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="@string/auto_certificats" android:textSize="14sp"
                    android:textColor="@color/text_primary" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/auto_str_4" android:textSize="20sp" android:textColor="@color/text_muted" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/menuNotifications"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/rounded_card"
                android:paddingHorizontal="14dp"
                android:layout_marginBottom="8dp">
                <ImageView android:layout_width="20dp" android:layout_height="20dp"
                    android:src="@drawable/ic_bell" app:tint="@color/text_primary" android:layout_marginEnd="12dp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="@string/notifications_label" android:textSize="14sp"
                    android:textColor="@color/text_primary" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/auto_str_4" android:textSize="20sp" android:textColor="@color/text_muted" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/menuDarkMode"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/rounded_card"
                android:paddingHorizontal="14dp"
                android:layout_marginBottom="8dp">
                <ImageView android:layout_width="20dp" android:layout_height="20dp"
                    android:src="@drawable/ic_moon" app:tint="@color/text_primary" android:layout_marginEnd="12dp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="@string/dark_mode" android:textSize="14sp"
                    android:textColor="@color/text_primary" />
                <Switch
                    android:id="@+id/switchDarkMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/menuLanguage"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/rounded_card"
                android:paddingHorizontal="14dp"
                android:layout_marginBottom="8dp">
                <ImageView android:layout_width="20dp" android:layout_height="20dp"
                    android:src="@drawable/ic_settings" app:tint="@color/text_primary" android:layout_marginEnd="12dp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="@string/language_label" android:textSize="14sp"
                    android:textColor="@color/text_primary" />
                <TextView
                    android:id="@+id/tvCurrentLang"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_fran_ais"
                    android:textSize="13sp"
                    android:textColor="@color/text_muted" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/auto_str_5" android:textSize="20sp" android:textColor="@color/text_muted" />
            </LinearLayout>

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/btn_outline"
                android:text="@string/logout"
                android:textColor="@color/error"
                android:textSize="14sp"
                android:textAllCaps="false"
                android:layout_marginTop="8dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
