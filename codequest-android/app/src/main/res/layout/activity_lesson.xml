<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_close"
            app:tint="@color/text_muted"
            android:padding="6dp" />

        <TextView
            android:id="@+id/tvLessonTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/auto_le_on"
            android:textSize="14sp"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginHorizontal="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auto_20_xp"
            android:textSize="11sp"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="@color/xp_gold"
            app:drawableStartCompat="@drawable/ic_lightning"
            app:drawableTint="@color/xp_gold"
            android:drawablePadding="4dp"
            android:background="@drawable/bg_xp_badge"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressLesson"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginHorizontal="16dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/progress_gradient" />

    <TextView
        android:id="@+id/tvSlideIndicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/auto_1_5"
        android:textSize="12sp"
        android:textColor="@color/text_muted"
        android:gravity="center"
        android:paddingTop="8dp"
        android:layout_marginBottom="4dp" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerSlides"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnPrevious"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/btn_outline"
            android:text="@string/auto_pr_c_dent"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/btn_primary"
            android:text="@string/auto_suivant"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:fontFamily="@font/poppins_semibold"
            android:textAllCaps="false"
            android:layout_marginStart="8dp" />
    </LinearLayout>

</LinearLayout>
