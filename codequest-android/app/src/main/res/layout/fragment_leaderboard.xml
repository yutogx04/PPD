<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_light">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/leaderboard_title"
        android:textSize="24sp"
        android:fontFamily="@font/poppins_bold"
        android:textColor="@color/text_primary"
        android:drawableStart="@drawable/ic_trophy"
        android:drawablePadding="8dp"
        android:padding="16dp"
        android:paddingBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/chipWeekly"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="@string/auto_semaine"
            android:textSize="13sp"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="@color/white"
            android:background="@drawable/tab_active"
            android:gravity="center"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/chipMonthly"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="@string/auto_mois"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:background="@drawable/tab_inactive"
            android:gravity="center"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/chipAllTime"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="@string/auto_tout"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:background="@drawable/tab_inactive"
            android:gravity="center" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/podiumContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom|center_horizontal"
        android:paddingHorizontal="32dp"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <ImageView
                android:id="@+id/ivAvatar2"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/circle_avatar"
                android:src="@drawable/ic_default_avatar"
                android:scaleType="centerInside"
                android:padding="2dp"
                android:layout_marginBottom="4dp"
                android:contentDescription="2nd place" />

            <TextView
                android:id="@+id/tvName2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auto_bytem"
                android:textSize="11sp"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/tvXp2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auto_1_620_xp"
                android:textSize="10sp"
                android:fontFamily="@font/poppins_bold"
                android:textColor="@color/podium_silver"
                android:layout_marginBottom="6dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@drawable/podium_silver" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:text="@string/auto_2"
                android:textSize="14sp"
                android:fontFamily="@font/poppins_bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:background="@color/podium_silver" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginHorizontal="8dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_crown"
                android:layout_marginBottom="2dp" />

            <ImageView
                android:id="@+id/ivAvatar1"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/circle_avatar"
                android:src="@drawable/ic_default_avatar"
                android:scaleType="centerInside"
                android:padding="2dp"
                android:layout_marginBottom="4dp"
                android:contentDescription="1st place" />

            <TextView
                android:id="@+id/tvName1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auto_algostar"
                android:textSize="12sp"
                android:fontFamily="@font/poppins_bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/tvXp1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auto_2_450_xp"
                android:textSize="11sp"
                android:fontFamily="@font/poppins_bold"
                android:textColor="@color/podium_gold"
                android:layout_marginBottom="6dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="@drawable/podium_gold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:text="@string/auto_1"
                android:textSize="14sp"
                android:fontFamily="@font/poppins_bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:background="@color/podium_gold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <ImageView
                android:id="@+id/ivAvatar3"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/circle_avatar"
                android:src="@drawable/ic_default_avatar"
                android:scaleType="centerInside"
                android:padding="2dp"
                android:layout_marginBottom="4dp"
                android:contentDescription="3rd place" />

            <TextView
                android:id="@+id/tvName3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auto_code_n"
                android:textSize="11sp"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/tvXp3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auto_1_380_xp"
                android:textSize="10sp"
                android:fontFamily="@font/poppins_bold"
                android:textColor="@color/podium_bronze"
                android:layout_marginBottom="6dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/podium_bronze" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:text="@string/auto_3"
                android:textSize="14sp"
                android:fontFamily="@font/poppins_bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:background="@color/podium_bronze" />
        </LinearLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLeaderboard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="16dp"
        android:clipToPadding="false" />

</LinearLayout>
