<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@drawable/bg_gradient_primary">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="Back" />

        <TextView
            android:id="@+id/tvModuleTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/auto_module_1"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/white" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/bg_gradient_primary">

        <TextView
            android:id="@+id/tvModuleDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auto_d_couvrez_les_bases"
            android:textSize="14sp"
            android:textColor="#C4B5FD"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvLessonCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auto_4_le_ons"
                android:textSize="13sp"
                android:textColor="@color/white"
                android:layout_marginEnd="16dp" />

            <TextView
                android:id="@+id/tvChallengeCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auto_2_d_fis"
                android:textSize="13sp"
                android:textColor="@color/white"
                android:layout_marginEnd="16dp" />

            <TextView
                android:id="@+id/tvXpReward"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auto_120_xp"
                android:textSize="13sp"
                android:textColor="@color/xp_gold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressModule"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:max="100"
            android:progress="0" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/auto_le_ons"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLessons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="false" />

    <TextView
        android:id="@+id/tvChallengesHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/auto_d_fis"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChallenges"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="false" />

</LinearLayout>
