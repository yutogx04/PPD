<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_onboarding_gradient">

    <TextView
        android:id="@+id/particle1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/auto_str_7"
        android:textColor="#1AA78BFA"
        android:fontFamily="@font/jetbrains_mono"
        android:textSize="14sp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="80dp" />

    <TextView
        android:id="@+id/particle2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/auto_lt_gt"
        android:textColor="#1AA78BFA"
        android:fontFamily="@font/jetbrains_mono"
        android:textSize="14sp"
        android:layout_gravity="end"
        android:layout_marginEnd="32dp"
        android:layout_marginTop="130dp" />

    <TextView
        android:id="@+id/particle3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/auto_def"
        android:textColor="#1AA78BFA"
        android:fontFamily="@font/jetbrains_mono"
        android:textSize="14sp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="350dp" />

    <TextView
        android:id="@+id/particle4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/auto_str_8"
        android:textColor="#1AA78BFA"
        android:fontFamily="@font/jetbrains_mono"
        android:textSize="14sp"
        android:layout_gravity="end"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="420dp" />

    <TextView
        android:id="@+id/particle5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/auto_gt"
        android:textColor="#1AA78BFA"
        android:fontFamily="@font/jetbrains_mono"
        android:textSize="14sp"
        android:layout_gravity="end"
        android:layout_marginEnd="56dp"
        android:layout_marginTop="240dp" />

    <TextView
        android:id="@+id/particle6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/auto_fn"
        android:textColor="#1AA78BFA"
        android:fontFamily="@font/jetbrains_mono"
        android:textSize="14sp"
        android:layout_marginStart="48dp"
        android:layout_marginTop="500dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_icon_gradient"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_lightning"
                app:tint="@color/white"
                android:layout_gravity="center" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_title"
            android:textSize="28sp"
            android:fontFamily="@font/poppins_bold"
            android:textColor="@color/white"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_subtitle"
            android:textSize="14sp"
            android:textColor="#99FFFFFF"
            android:layout_marginBottom="40dp" />

        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_icon_gradient"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/ivSlideIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:contentDescription="Slide icon" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvSlideTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="18sp"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="@color/white"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvSlideDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="14sp"
            android:textColor="#B3FFFFFF"
            android:lineSpacingExtra="4dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="24dp"
        android:paddingBottom="100dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auto_print_quot_hello_world_quot"
            android:fontFamily="@font/jetbrains_mono"
            android:textSize="11sp"
            android:textColor="#33FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auto_const_solve_n_gt_n_2"
            android:fontFamily="@font/jetbrains_mono"
            android:textSize="11sp"
            android:textColor="#1AFFFFFF"
            android:layout_marginTop="4dp" />
    </LinearLayout>

</FrameLayout>
