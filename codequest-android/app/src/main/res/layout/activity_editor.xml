<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary"
            android:padding="4dp" />

        <TextView
            android:id="@+id/tvChallengeTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/auto_inverser_une_cha_ne"
            android:textSize="16sp"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="@color/text_primary"
            android:layout_marginStart="8dp" />

        <TextView
            android:id="@+id/tvDifficultyTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auto_facile"
            android:textSize="10sp"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="@color/success"
            android:background="@drawable/badge_easy"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:layout_marginEnd="8dp" />

        <ImageView
            android:id="@+id/btnHint"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_lightbulb"
            app:tint="@color/xp_gold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/btn_outline">

        <TextView
            android:id="@+id/tabStatement"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/tab_statement"
            android:textSize="13sp"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="@color/white"
            android:background="@drawable/tab_active"
            android:gravity="center" />

        <TextView
            android:id="@+id/tabCode"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/tab_code"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:gravity="center" />

        <TextView
            android:id="@+id/tabResult"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/tab_result"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:gravity="center" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/statementSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStatement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_crivez_une_fonction_qui_re_oit"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_code_block"
                    android:padding="12dp"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auto_entr_e"
                        android:textSize="10sp"
                        android:fontFamily="@font/poppins_semibold"
                        android:textColor="#A78BFA"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvExampleInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/auto_quot_hello_quot"
                        android:fontFamily="@font/jetbrains_mono"
                        android:textSize="13sp"
                        android:textColor="@color/white" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_code_block"
                    android:padding="12dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auto_sortie"
                        android:textSize="10sp"
                        android:fontFamily="@font/poppins_semibold"
                        android:textColor="#4ADE80"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvExampleOutput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/auto_quot_olleh_quot"
                        android:fontFamily="@font/jetbrains_mono"
                        android:textSize="13sp"
                        android:textColor="@color/white" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/codeSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_editor"
                    android:padding="12dp"
                    android:minHeight="200dp">

                    <TextView
                        android:id="@+id/tvLineNumbers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auto_1"
                        android:fontFamily="@font/jetbrains_mono"
                        android:textSize="13sp"
                        android:textColor="@color/line_number"
                        android:layout_marginEnd="12dp"
                        android:gravity="end" />

                    <EditText
                        android:id="@+id/etCode"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:fontFamily="@font/jetbrains_mono"
                        android:textSize="13sp"
                        android:textColor="@color/white"
                        android:inputType="textMultiLine|textNoSuggestions"
                        android:scrollHorizontally="true"
                        android:gravity="top|start"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/consoleSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_code_block"
                android:padding="12dp"
                android:layout_marginTop="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/console_title"
                    android:textSize="10sp"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="@color/console_text"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvConsoleOutput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jetbrains_mono"
                    android:textSize="12sp"
                    android:textColor="@color/console_text" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:paddingHorizontal="16dp"
        android:gravity="center_vertical"
        android:background="@color/card_bg"
        android:elevation="4dp">

        <TextView
            android:id="@+id/tvEditorLang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auto_python_3"
            android:textSize="10sp"
            android:fontFamily="@font/jetbrains_mono"
            android:textColor="#4ADE80"
            android:background="@drawable/badge_easy"
            android:backgroundTint="#1A4ADE80"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnRun"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/btn_run"
            android:text="@string/auto_ex_cuter"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:fontFamily="@font/poppins_semibold"
            android:textAllCaps="false"
            android:paddingHorizontal="14dp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnSubmit"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/btn_submit"
            android:text="@string/auto_soumettre"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:fontFamily="@font/poppins_semibold"
            android:textAllCaps="false"
            android:paddingHorizontal="14dp" />
    </LinearLayout>

</LinearLayout>
