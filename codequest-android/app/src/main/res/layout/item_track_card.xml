<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/rounded_card"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/tvLangIcon"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/ic_book"
            app:tint="@color/python_text"
            android:background="@drawable/bg_badge_primary"
            android:backgroundTint="#E8F5E9"
            android:padding="8dp"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTrackName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auto_python"
                android:textSize="16sp"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvDifficulty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_beginner"
                android:textSize="11sp"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/success" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvXpPerLesson"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auto_20_xp_le_on"
            android:textSize="11sp"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="@color/primary"
            android:background="@drawable/bg_xp_purple"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/auto_variables_fonctions_listes_dic"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="10dp"
        android:maxLines="2"
        android:ellipsize="end" />

    <LinearLayout
        android:id="@+id/progressRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <ProgressBar
            android:id="@+id/progressBar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="0dp"
            android:layout_height="5dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/progress_gradient"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvProgressPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auto_40"
            android:textSize="12sp"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvModules"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auto_8_modules"
            android:textSize="11sp"
            android:textColor="@color/text_muted"
            app:drawableStartCompat="@drawable/ic_box"
            android:drawablePadding="4dp"
            app:drawableTint="@color/text_muted"
            android:layout_marginEnd="16dp" />

        <TextView
            android:id="@+id/tvLessons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auto_32_le_ons"
            android:textSize="11sp"
            android:textColor="@color/text_muted"
            app:drawableStartCompat="@drawable/ic_document"
            android:drawablePadding="4dp"
            app:drawableTint="@color/text_muted"
            android:layout_marginEnd="16dp" />

        <TextView
            android:id="@+id/tvChallenges"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auto_20_d_fis"
            android:textSize="11sp"
            app:drawableStartCompat="@drawable/ic_laptop"
            android:drawablePadding="4dp"
            app:drawableTint="@color/text_muted"
            android:textColor="@color/text_muted" />
    </LinearLayout>

    <Button
        android:id="@+id/btnAction"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/btn_primary"
        android:text="@string/continue_btn"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:fontFamily="@font/poppins_semibold"
        android:textAllCaps="false" />

</LinearLayout>
