<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/rounded_card"
    android:padding="12dp"
    android:layout_marginBottom="6dp">

    <ImageView
        android:id="@+id/ivResultIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_check"
        android:layout_marginEnd="10dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTestName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auto_test_1"
            android:textSize="13sp"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/tvTestDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auto_quot_hello_quot_quot_olleh_quo"
            android:textSize="11sp"
            android:fontFamily="@font/jetbrains_mono"
            android:textColor="@color/text_muted" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvTestTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/auto_12ms"
        android:textSize="11sp"
        android:fontFamily="@font/poppins_semibold"
        android:textColor="@color/text_muted" />
</LinearLayout>
